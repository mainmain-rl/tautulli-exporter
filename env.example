# Copy this file to .env for local development, or set these as real
# environment variables / Secret values in your deployment.

# --- Tautulli connection ----------------------------------------------------
TAUTULLI_URL=http://127.0.0.1:8181
TAUTULLI_BASE_PATH=
TAUTULLI_APIKEY=changeme
TAUTULLI_TIMEOUT=5
TAUTULLI_VERIFY_SSL=true

# --- HTTP server -------------------------------------------------------------
LISTEN_HOST=0.0.0.0
LISTEN_PORT=9105
LOG_LEVEL=INFO
