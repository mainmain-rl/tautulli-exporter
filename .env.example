# Tautulli Exporter Configuration
# Copy this file to .env and fill in your values

# Tautulli connection settings
TAUTULLI_URL="http://127.0.0.1:8081"
TAUTULLI_APIKEY=""
TAUTULLI_BASE_PATH=""  # Set if Tautulli is served behind a custom HTTP_ROOT
TAUTULLI_TIMEOUT=5     # Timeout in seconds for API calls
TAUTULLI_VERIFY_SSL=true  # Set to false for self-signed HTTPS certificates

# HTTP server settings
LISTEN_HOST=0.0.0.0  # Bind to all interfaces
LISTEN_PORT=9105     # Port the exporter listens on
LOG_LEVEL=info       # Logging level: debug, info, warn, error
